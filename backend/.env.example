# Base de datos (PostgreSQL). Puedes usar Railway, Supabase, Neon o local.
DATABASE_URL="postgresql://usuario:password@localhost:5432/catalogos_db"

# Puerto del servidor
PORT=4000

# Clave secreta para firmar los tokens JWT (cambia esto por algo largo y aleatorio)
JWT_SECRET="cambia-esto-por-una-clave-secreta-larga-y-aleatoria"

# Cloudinary (para subir imagenes y PDFs) - crea una cuenta gratis en cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
